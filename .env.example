# Required: token from @BotFather
TELEGRAM_BOT_TOKEN=123456:replace-me

# Required in practice: only these Telegram user IDs may use the bot (comma separated).
# Leave it empty and the manager is CLOSED to everyone. Not sure of your ID? Start the bot and message it once: it replies
# with your ID (the log also shows a "⛔ blocked user <id>" line).
ALLOWED_USER_IDS=
# Old behaviour (anyone who finds the bot can add bots from your server's IP): only with ALLOWED_USER_IDS empty, on purpose.
# ALLOW_OPEN_ACCESS=1

# Bots may not be pointed at this machine, a local network or a link-local address (an allowed user could otherwise probe your
# VPS and its network through the error messages). Set 1 if the Minecraft server runs on this VPS or your LAN. Applies to NEW bots.
# MC_ALLOW_PRIVATE_HOSTS=1

# Optional limits on how many bots one user / the whole manager can have (0 = no limit).
# MAX_BOTS_PER_USER=5
# MAX_BOTS_TOTAL=20

# Optional: bots that were running when the process stopped reconnect by themselves (default on; 0 = stay paused until Reconnect).
# RESUME_SPREAD_MS is the gap between those starts; the join queue (JOIN_GAP_MS) spaces the actual logins per server.
# AUTO_RESUME=1
# After this many unclean starts in a row (within 10 min) bots are NOT auto-resumed (a crash at boot would log them in on every
# restart). They come back at the next clean start, or press Reconnect. 0 = never hold.
# RESUME_CRASH_LOOP_STARTS=3
# RESUME_SPREAD_MS=300

# Optional: where userdata.json, its .bak1-3 backups and .keysecret are stored (default: next to index.js)
# DATA_DIR=/var/lib/mcafk

# Optional: external heartbeat (e.g. a healthchecks.io check URL). Pinged every minute while the bot is healthy;
# the monitoring service alerts you when the pings stop (kill -9, power cut, hung process). The URL is never logged.
# HEARTBEAT_URL=https://hc-ping.com/your-check-uuid

# Optional tuning (milliseconds): the gap between join attempts to the same server (0 = off) and the wait after a
# "Connection throttled" kick.
# JOIN_GAP_MS=5000
# THROTTLE_RETRY_MS=5000

# Optional: chunks each bot asks the server for (2-32, or "default" = mineflayer's large default). Memory per bot grows with
# the square of this. A bot with a proximity alert is raised automatically so the alert keeps working.
# MC_VIEW_DISTANCE=4

# Optional, off by default and NOT measured: a bot that has stood still for MC_IDLE_AFTER_MIN minutes (default 30) asks the server
# for this smaller view distance (2-32) and goes back to normal when it moves. Per-bot override: /settings -> View distance.
# MC_IDLE_VIEW_DISTANCE=2
# MC_IDLE_AFTER_MIN=30

# Optional: cap Node's heap (MB) on a small VPS. On a big one (16 GB) leave it unset: Node sizes its own limit from the machine.
# NODE_OPTIONS=--max-old-space-size=256

# --- Bigger VPS (e.g. 16 GB RAM / 4 vCPU) ---------------------------------------------------------------------------------
# The limits above were chosen for a small box. All bots share ONE Node thread, so the first wall on a big machine is that core,
# not RAM: watch the "Load" row in /status. Raise the caps in steps (e.g. +10 bots), let it run, check Load, repeat; stop when CPU
# stays above ~85% of one core or loop lag p99 above ~250 ms (the console and /status then say "one core is the limit").
# Per-bot CPU is NOT measured, so there is deliberately no recommended number here.
# MAX_BOTS_TOTAL=60
# MAX_BOTS_PER_USER=15
# Leave MC_VIEW_DISTANCE at 4: a larger radius costs RAM and CPU and an AFK bot gains nothing (per-bot override: /settings).
